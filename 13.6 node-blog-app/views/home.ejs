<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Home Page</title>
    <%- include('./partials/head') %>
  </head>
  <body>
    <%- include('./partials/scripts') %>
    <section><%- include('./partials/navbar')%></section>
   
    <div class="container mt-4">

<h4>My recent blogs</h4>
<div class="card-group">
<% blogs.map((blog) => { %>

  <div class="card mb-3" style="max-width: 540px;">
  <div class="row g-1">
    <div class="col-md-4">
      <img src="<%= blog.coverImage%>" class="img-fluid rounded-start p-4" alt="...">
    </div>
    <div class="col-md-8">
      <div class="card-body ">
        <p class="card-text"><small class="text-body-secondary"><%= moment(blog.updatedAt).format('MMM DD YYYY hh:mm a')%></small></p>
        <h4 class="card-title"><%=blog.title %></h4>

      <div class="container">
        <img
          src="<%=user.profileImage%>"
          class="rounded-circle"
          width="48px"
        />
        <small><%=user.fullName%></small>
      </div>
              <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <a class="btn btn-primary" href="/blog/<%=blog._id%>" role="button">View</a>
        </div>
      </div>
    </div>
  </div>
</div>
  <% }); %>
</div>

    </div>
  </body>
</html>
