<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>

    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 20px;
        background-color: #f4f4f4;
      }
      h1 {
        color: #333;
      }
      form {
        margin-top: 20px;
      }
      input[type="url"] {
        width: 300px;
        padding: 10px;
        margin-right: 10px;
      }
      button {
        padding: 10px 20px;
        background-color: #007bff;
        color: white;
        border: none;
        cursor: pointer;
      }
      button:hover {
        background-color: #0056b3;
      }
      section {
        margin-top: 40px;
      }
    </style>
  </head>
  <body>
    <h2>SPXPERT Login</h2>
    <form action="/user/login" method="post">
      <label>Email</label>
      <input type="email" required name="email" />
      <label>Password</label>
      <input type="password" required name="password" />

      <button type="Submit">Login</button>
    </form>
  </body>
</html>
